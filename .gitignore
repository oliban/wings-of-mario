node_modules/

# Generated capture artifacts — every PNG here is reproducible with
#   node tools/sheet.mjs <module>      (art contact sheets)
#   npm run shots                      (gameplay scenes)
shots/
!shots/showcase/

.DS_Store
*.log

# The room table between restarts. Runtime state of one machine, never source:
# it holds live room codes and their reconnect tokens. See server/persist.js.
server/rooms.json
server/rooms.json.tmp
reference/

# Isolated agent worktrees. A background agent given its own worktree gets a
# full copy of the repo dropped in here — never commit it. Scoped to
# worktrees/ rather than all of .claude/ so real project config stays visible.
.claude/worktrees/
.superpowers/
